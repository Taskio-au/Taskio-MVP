## Taskio frontend staging production build
## Supply these as process-scoped variables. Do not copy phones, OTPs or secret keys.

REACT_APP_FIREBASE_EXPECTED_PROJECT_ID=taskio-v2-staging
REACT_APP_FIREBASE_API_KEY=REPLACE_WITH_STAGING_WEB_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=taskio-v2-staging.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=taskio-v2-staging
REACT_APP_FIREBASE_STORAGE_BUCKET=taskio-v2-staging.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_SENDER_ID
REACT_APP_FIREBASE_APP_ID=REPLACE_WITH_STAGING_APP_ID

REACT_APP_API_BASE_URL=https://taskio-api-staging-d6mdcsrwea-ts.a.run.app

# Optional. TEST mode only. Never pk_live_.
# REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Must be absent or false for a hosted staging production build.
REACT_APP_DISABLE_PHONE_RECAPTCHA=false
REACT_APP_E2E_AUTH_BYPASS=false

# Scanner-only. Never supply these to the staging build process.
# TASKIO_STAGING_SCAN_FIXTURE_FILE=

# App Check activation only after provider registration approval (build-time, public key).
# REACT_APP_APPCHECK_ENABLED=true
# REACT_APP_APPCHECK_PROVIDER=recaptcha-enterprise
# REACT_APP_APPCHECK_SITE_KEY=REPLACE_WITH_PUBLIC_STAGING_SITE_KEY
# Never supply App Check debug configuration to hosted builds.
