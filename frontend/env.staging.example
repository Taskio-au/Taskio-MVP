## Taskio staging frontend environment example
## Supply these variables through the staging build environment.
## For a deliberate local staging build only, copy them to the ignored
## frontend/.env.production.local immediately before running `npm run build`.
## Replace placeholders with the Web App values from taskio-v2-staging.
## Never use production values in this file.

REACT_APP_FIREBASE_EXPECTED_PROJECT_ID=taskio-v2-staging
REACT_APP_FIREBASE_API_KEY=replace_with_staging_web_app_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=taskio-v2-staging.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=taskio-v2-staging
REACT_APP_FIREBASE_STORAGE_BUCKET=taskio-v2-staging.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=replace_with_staging_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=replace_with_staging_web_app_id

# Add the staging Express API URL only after that service exists.
REACT_APP_API_BASE_URL=https://replace-with-staging-api-url

# Stripe staging must remain in test mode. Do not add a live publishable key.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Keep App Check disabled until its staging registration and enforcement plan are reviewed.
REACT_APP_APPCHECK_ENABLED=false
