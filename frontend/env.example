## Taskio Frontend environment example
## Copy these into: Taskio-MVP/frontend/.env

# API base URL
REACT_APP_API_BASE_URL=http://localhost:8000

# Production builds fail closed when this value is missing, non-HTTPS, or local.
# Intended eventual production value (do not treat as evidence of deployment):
# REACT_APP_API_BASE_URL=https://api.taskio.com.au

# Test-only. Production builds fail if this is true.
REACT_APP_E2E_AUTH_BYPASS=false

# Public acquisition (open guest OTP job-post + expert self-signup).
# Leave unset/false for the private invite-only Melbourne MVP.
# REACT_APP_PUBLIC_ACQUISITION_ENABLED=true

# Firebase Storage bucket override (optional but recommended for local dev reliability)
# If uploads hang at 0%, set this to your actual bucket name from Firebase Console → Storage.
# Common values:
# - taskio-v2.appspot.com
# - taskio-v2.firebasestorage.app
# REACT_APP_STORAGE_BUCKET=taskio-v2.appspot.com

# Stripe publishable key (optional)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# App Check (optional; recommended for production)
# REACT_APP_APPCHECK_ENABLED=true
# REACT_APP_APPCHECK_SITE_KEY=your_recaptcha_v3_site_key
#
# Local dev helper:
# REACT_APP_APPCHECK_DEBUG_TOKEN=true
