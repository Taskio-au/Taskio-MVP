## Taskio Backend environment example
## Copy these into: Taskio-MVP/backend/.env

# Server
PORT=8000
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false
OTP_SALT=replace_with_a_long_random_secret

# Optional alerting webhook for critical backend errors
# ALERT_WEBHOOK_URL=https://hooks.example.com/taskio-alerts

# CORS (required in production)
# CORS_ORIGINS=http://localhost:3000

# Stripe (optional)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=http://localhost:3000
# TASKIO_SHOW_DEV_OTP=true
# In production use sk_live_xxx, keep TASKIO_SHOW_DEV_OTP disabled,
# and set CORS_ORIGINS, TRUST_PROXY=true, ALERT_WEBHOOK_URL, and OTP_SALT.

# Gemini (AI) - backend only (NEVER put this in frontend env)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_VERSION=v1
GEMINI_MODEL=gemini-3.6-flash

# Firebase Admin (optional for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# In production prefer managed runtime secrets or ADC. Avoid local JSON files on hosts.

# ABN Lookup (ABR) Web Services (recommended)
# Register for a GUID at: https://abr.business.gov.au/Tools/WebServices
# Then set:
ABN_LOOKUP_GUID=your_abr_webservices_guid_here
