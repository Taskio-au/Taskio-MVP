## Taskio staging runtime contract (no secret values)
## Staging must run production-hardened code against taskio-v2-staging only.
## This file is documentation, not a single combined runtime dotenv.

NODE_ENV=production
TASKIO_DEPLOYMENT_ENV=staging
GOOGLE_CLOUD_PROJECT=taskio-v2-staging
PORT=8080

# ----- Main API service (private) -----
# Do not set STRIPE_WEBHOOK_SECRET or STRIPE_CONNECT_WEBHOOK_SECRET on the main API.
# The Stripe API key remains private-API only.
STRIPE_ENABLED=true
STRIPE_EXPECTED_LIVEMODE=false
STRIPE_SECRET_KEY=secret-manager:taskio-staging-stripe-secret-key
STRIPE_INTERNAL_AUDIENCE=https://REPLACE_WITH_PRIVATE_STAGING_API_ORIGIN
STRIPE_WEBHOOK_CALLER_SERVICE_ACCOUNT=REPLACE_WITH_WEBHOOK_RUNTIME_SERVICE_ACCOUNT_EMAIL
FRONTEND_URL=https://REPLACE_WITH_STAGING_FRONTEND_ORIGIN
CORS_ORIGINS=https://REPLACE_WITH_STAGING_FRONTEND_ORIGIN
TRUST_PROXY=true
ENABLE_SET_ADMIN_ENDPOINT=false
TASKIO_SHOW_DEV_OTP=false
# Keep false until an explicit owner launch/signup approval. Staging uses NODE_ENV=production,
# so a missing flag also disables public enrollment.
TASKIO_PUBLIC_SIGNUP_ENABLED=false

# ----- Webhook-only service -----
# Copy only these application settings onto the webhook runtime:
# NODE_ENV, TASKIO_DEPLOYMENT_ENV, GOOGLE_CLOUD_PROJECT, PORT,
# STRIPE_ENABLED, STRIPE_EXPECTED_LIVEMODE, STRIPE_WEBHOOK_SECRET,
# STRIPE_CONNECT_WEBHOOK_SECRET, STRIPE_INTERNAL_AUDIENCE.
# Both signing secrets belong only to the webhook runtime.
# The private API gets neither signing secret.
# The Stripe API key remains private-API only and must not be given to this service.
# It must not receive Firebase credentials, Gemini credentials, ABN credentials,
# OTP secrets, or frontend configuration.
# STRIPE_WEBHOOK_SECRET=secret-manager:taskio-staging-stripe-webhook-secret
# STRIPE_CONNECT_WEBHOOK_SECRET=secret-manager:taskio-staging-stripe-connect-webhook-secret
# Staging requires two Stripe TEST webhook destinations on this same service:
#   platform/account -> POST /api/stripe/webhook
#   connected accounts -> POST /api/stripe/connect-webhook
