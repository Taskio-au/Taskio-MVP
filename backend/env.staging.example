## Taskio staging runtime contract (no secret values)
## Staging must run production-hardened code against taskio-v2-staging only.

NODE_ENV=production
TASKIO_DEPLOYMENT_ENV=staging
GOOGLE_CLOUD_PROJECT=taskio-v2-staging
PORT=8080

# Main API service
STRIPE_ENABLED=true
STRIPE_EXPECTED_LIVEMODE=false
STRIPE_SECRET_KEY=secret-manager:taskio-staging-stripe-secret-key
STRIPE_WEBHOOK_SECRET=secret-manager:taskio-staging-stripe-webhook-secret
STRIPE_INTERNAL_AUDIENCE=https://REPLACE_WITH_PRIVATE_STAGING_API_ORIGIN
STRIPE_WEBHOOK_CALLER_SERVICE_ACCOUNT=REPLACE_WITH_WEBHOOK_RUNTIME_SERVICE_ACCOUNT_EMAIL
FRONTEND_URL=https://REPLACE_WITH_STAGING_FRONTEND_ORIGIN
CORS_ORIGINS=https://REPLACE_WITH_STAGING_FRONTEND_ORIGIN
TRUST_PROXY=true
ENABLE_SET_ADMIN_ENDPOINT=false
TASKIO_SHOW_DEV_OTP=false

# Webhook-only service uses only these application settings:
# NODE_ENV, TASKIO_DEPLOYMENT_ENV, GOOGLE_CLOUD_PROJECT, PORT,
# STRIPE_ENABLED, STRIPE_EXPECTED_LIVEMODE, STRIPE_WEBHOOK_SECRET,
# STRIPE_INTERNAL_AUDIENCE.
# It must not receive STRIPE_SECRET_KEY, Firebase credentials, Gemini credentials,
# ABN credentials, OTP secrets, or frontend configuration.
